[Unit]
Description=Organizer recovery for the disposable Summit demo service only

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /opt/summit-red-agent/service_actions.py --recover
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/summit-red-agent
MemoryMax=64M
TasksMax=8
TimeoutStartSec=10
StandardOutput=journal
StandardError=journal
