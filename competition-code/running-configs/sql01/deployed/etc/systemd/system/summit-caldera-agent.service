[Unit]
Description=Visible unprivileged SQL CALDERA contact
After=network-online.target
Wants=network-online.target
[Service]
User=summit-caldera-agent
Group=summit-caldera-agent
ExecStart=/usr/bin/python3 /opt/summit-caldera-fixtures/fixture_agent.py --config /etc/summit-caldera-fixtures/agent/config.json
Restart=no
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0077
MemoryMax=48M
CPUQuota=10%
TasksMax=24
[Install]
WantedBy=multi-user.target
