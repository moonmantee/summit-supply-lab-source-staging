[Unit]
Description=Visible unprivileged Summit CALDERA fixture contact
After=network-online.target summit-caldera-broker.service
Wants=network-online.target
[Service]
User=summit-caldera-agent
Group=summit-caldera-agent
ExecStart=/usr/bin/python3 /opt/summit-caldera-fixtures/fixture_agent.py --config /etc/summit-caldera-fixtures/agent/config.json
Restart=no
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=
UMask=0077
MemoryMax=64M
CPUQuota=10%
TasksMax=8
[Install]
WantedBy=multi-user.target
