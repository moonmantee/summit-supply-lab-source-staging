[Unit]
Description=Visible Summit CALDERA fixed-event fixture broker
After=network-online.target
Wants=network-online.target
[Service]
User=root
Group=summit-caldera-agent
ExecStart=/usr/bin/python3 /opt/summit-caldera-fixtures/fixture_broker.py --config /etc/summit-caldera-fixtures/broker/config.json
Restart=no
RuntimeDirectory=summit-caldera-broker
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/summit-red-agent /var/lib/summit-caldera-business
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=128M
CPUQuota=10%
TasksMax=24
[Install]
WantedBy=multi-user.target
